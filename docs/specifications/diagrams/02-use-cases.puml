@startuml
!include theme.puml
title ERP | Actors and core use cases
left to right direction
actor Student as S
actor "Staff\n(instructor / employee)" as T
actor Admin as A
actor "Super admin" as SA
actor "Payment provider" as P
rectangle "ERP: web screens + business APIs" {
  usecase "Authenticate /\nrotate session" as login
  usecase "Enroll + view\nasynchronous invoice" as enroll
  usecase "Register for\na course offering" as register
  usecase "Check published\nprerequisite results" as prerequisites
  usecase "View published grades" as grades
  usecase "Submit a grade appeal" as appeal
  usecase "Download transcript /\nattendance summary PDF" as reports
  usecase "Pay tuition /\ndownload receipt" as pay
  usecase "Manage teaching,\nexams and appeals\n(API-only staff UI gap)" as teaching
  usecase "Fees / expenses /\ncampaigns / summaries\n(API-only staff UI gap)" as finance
  usecase "Own leave, check-in,\nnotifications, payslips" as own
  usecase "Recruitment / assets /\nleave decisions / payroll\n(API-only admin UI gap)" as hr
  usecase "Attest payroll\nrate schedule" as attest
  usecase "Obtain provider\nsettlement status" as status
}
S --> login
T --> login
A --> login
SA --> login
S --> enroll
S --> register
S --> grades
S --> reports
S --> pay
T --> teaching
T --> finance
T --> own
A --> teaching
A --> finance
A --> hr
SA --> hr
SA --> attest
pay ..> status : <<include>>
register ..> prerequisites : <<include>>
appeal .left.> grades : <<extend>>\n[student disputes a published grade]
P --> status
legend bottom
  Actor -- use case: participation / association
  <<include>>: required behavior; arrow points to the included use case
  <<extend>>: optional behavior; arrow points to the base use case
  Viewing grades does not require an appeal; registration checks prerequisites.
  ----
  Staff teaching actions require an assigned offering.
  Admin and super-admin may manage offerings; admin UI screens remain partial.
  The UI route guard authenticates; page-level checks select content or placeholders.
  Payroll attestation is manual, not automated tax validation.
  Tenant context is required for ordinary mutations.
endlegend
@enduml
