# --- Postgres (bootstrap superuser only; services never use this account) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=postgres

# --- Per-service database credentials (see ops/postgres/init) ---
IDENTITY_DB_PASSWORD=identity_dev_password
ACADEMIC_DB_PASSWORD=academic_dev_password
FINANCE_DB_PASSWORD=finance_dev_password
HR_DB_PASSWORD=hr_dev_password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=erp_app
RABBITMQ_DEFAULT_PASS=erp_dev_password

# --- Deployment (used by docker-compose.prod.yml / Jenkins; leave blank locally) ---
ERP_DOMAIN=
REGISTRY_HOST=
REGISTRY_NAMESPACE=
IMAGE_TAG=local
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=

# --- CamerPay (Phase 5; branded payment gateway wrapper around the MTN MoMo
# Collection API - leave blank until sandbox credentials are provisioned) ---
CAMERPAY_PROVIDER=mtn_momo
CAMERPAY_SUBSCRIPTION_KEY=
CAMERPAY_API_USER=
CAMERPAY_API_KEY=
CAMERPAY_TARGET_ENVIRONMENT=sandbox
