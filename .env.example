# --- Postgres (bootstrap superuser only; services never use this account) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=postgres

# --- Per-service database credentials (see ops/postgres/init) ---
IDENTITY_DB_PASSWORD=identity_dev_password
ACADEMIC_DB_PASSWORD=academic_dev_password
FINANCE_DB_PASSWORD=finance_dev_password
HR_DB_PASSWORD=hr_dev_password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=erp_app
RABBITMQ_DEFAULT_PASS=erp_dev_password

# --- Deployment (used by docker-compose.prod.yml / Jenkins; leave blank locally) ---
ERP_DOMAIN=
REGISTRY_HOST=
REGISTRY_NAMESPACE=
IMAGE_TAG=local
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=

# --- CamerPay (Phase 5; branded payment gateway wrapper around the MTN MoMo
# Collection API). CAMERPAY_PROVIDER=test_double uses a deterministic
# in-process fake (no external calls, no credentials needed) - this is the
# default for local dev/CI. Set to mtn_momo + fill in the credentials below
# only once real MTN sandbox access is provisioned; never claim live
# sandbox validation without doing so. ---
CAMERPAY_PROVIDER=test_double
CAMERPAY_SUBSCRIPTION_KEY=
CAMERPAY_API_USER=
CAMERPAY_API_KEY=
CAMERPAY_TARGET_ENVIRONMENT=sandbox

# --- camerpay.biz aggregator API (CAMERPAY_PROVIDER=camerpay) - a hosted-
# redirect gateway distinct from the direct mtn_momo mode above: initiate
# returns a pay_url to redirect the browser to, and CamerPay POSTs a
# form-encoded, HMAC-SHA256-signed webhook to CAMERPAY_MERCHANT_CALLBACK_URL
# on completion. See https://camerpay.biz/docs/authentication and
# .../docs/webhooks. Never commit real values here - this file only ships
# placeholders. ---
CAMERPAY_TOKEN=
CAMERPAY_BASE_URL=https://camerpay.biz/api
CAMERPAY_CALLBACK_SECRET=
# Must resolve through this gateway's /api/v1/* routing - a bare /callback
# path is not proxied anywhere.
CAMERPAY_MERCHANT_CALLBACK_URL=https://YOUR_DOMAIN/api/v1/finance/payments/callback/camerpay
CAMERPAY_MERCHANT_RETURN_URL=https://YOUR_DOMAIN/finance

# --- HR (Phase 6) QR shift-attendance tokens: HR-internal HMAC secret,
# never shared with any other service. Generate a real random value per
# environment (e.g. `openssl rand -hex 32`); this default is dev-only. ---
HR_QR_SIGNING_SECRET=dev-only-insecure-default-change-me

# --- Admin MFA (email OTP, identity service). MFA is mandatory for admin
# and super_admin logins. `console` is a DISCLOSED dev substitute that logs
# the code to the identity service log instead of emailing it; identity
# refuses to start in production unless this is `brevo` with a real key.
# Never commit a real BREVO_API_KEY here. ---
MFA_EMAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@YOUR_DOMAIN
BREVO_SENDER_NAME=ICT University ERP
